# Password admin untuk menu registrasi (fallback: Face#01)
ADMIN_PASS="Face#01"

# ⚠️⚠️ MODE LEMBIR SEMENTARA — JANGAN DIBIARKAN AKTIF DI PRODUKSI ⚠️⚠️
# Set true kalau IP komputer belum terdaftar di hrd2.tpabrik atau proxy nginx
# belum dikonfigurasi, supaya absensi tetap bisa jalan. Setelah jaringan beres,
# hapus baris ini (atau set false) lalu restart backend.
# LOCAL_STORE = kode toko yang dipakai saat mode ini aktif (mis. K09).
# WAJIB diisi dengan kode toko komputer ini, karena data wajah yang dimuat
# difilter per toko. Kalau dikosongkan, backend memakai toko pertama yang aktif.
BYPASS_IP_CHECK=true
LOCAL_STORE=K09

# Koneksi Database (aktif, diambil oleh server.js via dotenv)
# Catatan: nilai berisi karakter khusus (#, spasi) WAJIB dikutip "..." 
# supaya tidak terpotong (dotenv menganggap # sebagai komentar).
DB_HOST="172.17.0.70"
DB_USER="kencana"
DB_PASSWORD="Kencana#123"
DB_NAME=absensi

# IP reverse proxy (nginx/Apache) yang boleh menyetor X-Forwarded-For, pisahkan koma.
# WAJIB diisi dengan alamat proxy sungguhan. Kalau kosong atau tidak cocok, IP
# WireGuard komputer tidak terbaca dan absensi ditolak sebagai "tidak terdaftar".
# "loopback" = proxy dan backend berada di mesin yang sama.
# Tambahkan juga IP server bila nginx listen di 172.17.0.87, bukan 127.0.0.1.
TRUST_PROXY_IPS="loopback,172.17.0.87"

# Port backend. Di server live browser memakai 8083 (nginx), sedangkan Node
# tetap listen di 8081 di belakang proxy. Kalau nginx TIDAK ada dan Node
# sendiri harus melayani 8083, isi PORT=8083 lalu restart.
PORT=8081
HOST=0.0.0.0
SERVER_IP=172.17.0.87